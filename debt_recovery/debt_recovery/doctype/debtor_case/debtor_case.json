   "in_global_search": 1
  },
  {
   "fieldname": "police_case_date",
   "fieldtype": "Date",
   "label": "Police Case Date",
   "depends_on": "has_police_case"
  },
  {
   "fieldname": "cb3",
   "fieldtype": "Column Break"
  },
