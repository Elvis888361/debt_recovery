   "fieldname": "commission_amount",
   "fieldtype": "Currency",
   "label": "Our Commission",
   "read_only": 1
  },
  {
   "fieldname": "cb5",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "net_payable_to_client",
