{
 "doctype": "DocType",
 "name": "Debtor Case",
 "module": "Debt Recovery",
 "engine": "InnoDB",
 "custom": 0,
 "fields": [
  {
   "fieldname": "tab_details",
   "fieldtype": "Tab Break",
   "label": "Details"
  },
  {
   "fieldname": "client",
   "fieldtype": "Link",
   "label": "Client (Creditor)",
   "options": "Recovery Client",
   "reqd": 1,
   "in_standard_filter": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "client_reference",
   "fieldtype": "Data",
   "label": "Client's Account / Reference No",
   "in_standard_filter": 1,
   "in_global_search": 1
  },
  {
   "fieldname": "debtor_type",
   "fieldtype": "Select",
   "label": "Debtor Type",
   "options": "Individual\nCompany",
   "default": "Individual"
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "Case Status",
   "options": "New\nContacted\nPromise to Pay\nPayment Plan\nPolice Case\nProsecution\nSettled\nReturned to Client\nClosed",
   "default": "New",
   "in_standard_filter": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "cb1",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "acquired_date",
   "fieldtype": "Date",
   "label": "Account Acquired On",
   "reqd": 1,
   "default": "Today",
   "in_standard_filter": 1,
   "in_list_view": 1,
   "description": "Date the client gave us this account"
  },
  {
   "fieldname": "assigned_to",
   "fieldtype": "Link",
   "label": "Assigned To",
   "options": "Employee",
   "in_standard_filter": 1
  },
  {
   "fieldname": "next_followup_date",
   "fieldtype": "Date",
   "label": "Next Follow-up",
   "in_standard_filter": 1
  },
  {
   "fieldname": "registered_by",
   "fieldtype": "Link",
