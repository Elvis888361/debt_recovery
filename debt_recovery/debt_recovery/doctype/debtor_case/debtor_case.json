  },
  {
   "fieldname": "sec_debtor",
   "fieldtype": "Section Break",
   "label": "Debtor"
  },
  {
   "fieldname": "debtor_name",
   "fieldtype": "Data",
   "label": "Debtor Name",
   "reqd": 1,
   "in_list_view": 1,
   "in_global_search": 1
  },
  {
   "fieldname": "debtor_status",
   "fieldtype": "Select",
   "label": "Debtor Status",
   "options": "Alive\nDeceased\nUnknown",
   "default": "Alive"
  },
  {
   "fieldname": "cb2",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "debtor_cpr",
   "fieldtype": "Data",
   "label": "Debtor CPR / ID",
